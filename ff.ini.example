# Fast Fusion (FF SlowSeparation) — example / safe defaults
# Hardware-agnostic baseline. Do not ship a personal ff.ini in releases.
# Raise the internal resolution, upscaling, and frame generation yourself, in FFLauncher or in-game (F1).

[paths]
exefs = ./exefs
romfs = ./romfs

[performance]
timer_1ms = 1
replay_async = 0
LANG = en-US
MENU_LANG = en

[display]
operation_mode = docked
window_size = 1920x1080
fullscreen = 0
output_res = 1920x1080
# The Fast Fusion resolution hooks (runtime/resolution.c): native 1:1 rendering, no half-res dynamic shrink.
res_hook = 1
render_scale = game
upscaler = fsr
upscaler_preset = quality
sharpness = 80
perf_overlay = off
vk_present = mailbox
color_preset = default

[graphics]
# original = the console tier (1920x1080 docked); 720 | 900 | 1080 | 1440 (2560x1440) | 2160 (4K)
resolution = original
aniso = 16

[frame rate]
fps_limit = 60
fg_mode = off

[input]
pad_layout = auto
rumble_strength = 100

[language]
menu_theme = fusion
